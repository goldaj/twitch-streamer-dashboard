# Windows PowerShell: define these variables in the process, NOT in Git.
# TWITCH_CHANNEL is the channel login, not a URL.
TWITCH_CHANNEL=your_channel
TWITCH_CLIENT_ID=your_registered_app_client_id
TWITCH_CLIENT_SECRET=your_registered_app_secret
OBS_WEBSOCKET_PASSWORD=your_local_obs_password
# Defaults to ws://127.0.0.1:4455, must remain on loopback.
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
